                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    USERS {\n        int user_id PK\n        varchar name\n        varchar email UK\n        varchar password\n        datetime created_at\n    }\n\n    BUSES {\n        int bus_id PK\n        varchar bus_number UK\n        varchar bus_name\n        varchar bus_type\n        varchar status\n    }\n\n    ROUTES {\n        int route_id PK\n        varchar route_number UK\n        varchar route_name\n        varchar start_point\n        varchar end_point\n    }\n\n    BUS_STOPS {\n        int stop_id PK\n        varchar stop_name\n        varchar city\n        varchar location\n        int route_id FK\n    }\n\n    SCHEDULES {\n        int schedule_id PK\n        int bus_id FK\n        int route_id FK\n        int stop_id FK\n        time arrival_time\n        time departure_time\n        varchar day\n    }\n\n    LIVE_TRACKING {\n        int tracking_id PK\n        int bus_id FK\n        decimal latitude\n        decimal longitude\n        decimal speed\n        datetime updated_at\n    }\n\n    AI_PREDICTIONS {\n        int prediction_id PK\n        int user_id FK\n        int bus_id FK\n        int stop_id FK\n        int predicted_minutes\n        varchar recommendation\n        datetime prediction_time\n    }\n\n    WEATHER {\n        int weather_id PK\n        varchar city\n        decimal temperature\n        decimal humidity\n        decimal wind_speed\n        varchar condition\n        datetime updated_at\n    }\n\n    NOTIFICATIONS {\n        int notification_id PK\n        int user_id FK\n        int bus_id FK\n        varchar title\n        text message\n        varchar notification_type\n        datetime created_at\n    }\n\n    FAVORITES {\n        int favorite_id PK\n        int user_id FK\n        int route_id FK\n        int bus_id FK\n        int stop_id FK\n        datetime created_at\n    }\n\n    FEEDBACK {\n        int feedback_id PK\n        int user_id FK\n        varchar subject\n        text message\n        int rating\n        datetime created_at\n    }\n\n    QR_CODES {\n        int qr_id PK\n        int stop_id FK\n        varchar qr_code\n        varchar qr_url\n        datetime created_at\n    }\n\n    EMERGENCY_CONTACTS {\n        int contact_id PK\n        varchar service_name\n        varchar phone_number\n        varchar description\n    }\n\n\n    USERS ||--o{ AI_PREDICTIONS : makes\n    USERS ||--o{ NOTIFICATIONS : receives\n    USERS ||--o{ FAVORITES : saves\n    USERS ||--o{ FEEDBACK : submits\n\n    ROUTES ||--o{ BUS_STOPS : contains\n    ROUTES ||--o{ SCHEDULES : has\n    ROUTES ||--o{ FAVORITES : can_be_saved\n\n    BUSES ||--o{ SCHEDULES : follows\n    BUSES ||--o{ LIVE_TRACKING : tracked\n    BUSES ||--o{ AI_PREDICTIONS : predicted\n    BUSES ||--o{ NOTIFICATIONS : generates\n    BUSES ||--o{ FAVORITES : can_be_saved\n\n    BUS_STOPS ||--o{ SCHEDULES : has\n    BUS_STOPS ||--o{ AI_PREDICTIONS : predicts\n    BUS_STOPS ||--o{ FAVORITES : can_be_saved\n    BUS_STOPS ||--o{ QR_CODES : has\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tnuJPFWwAl9sZ0EWkUdv-1">
